{
	"name": "obsidian-github-sync",
	"version": "0.1.0",
	"description": "Obsidian plugin that syncs the vault with GitHub on startup",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian", "github", "sync"],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"builtin-modules": "^5.0.0",
		"esbuild": "^0.28.0",
		"obsidian": "^1.14.0",
		"tslib": "^2.8.0",
		"typescript": "^5.9.0"
	}
}
